# Deny new root files by default; publish only source and known templates.
/*
!/.gitignore
!/.env.example
!/*.py
!/*.cjs
!/README.md
!/README-hosted.md
!/requirements.txt
!/requirements-hosted.txt
!/config.example.json
!/config.schema.json
!/examples/
/examples/*
!/examples/with_images.json
!/math_check/
/math_check/*
!/math_check/package.json
!/math_check/package-lock.json
# Superseded one-off helper; the public CLI uses math_validator.cjs.
/check_math.cjs

# Credentials and machine-specific settings
.env
.env.*
!.env.example
config.json
config.local.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Private documents, task plans, OCR responses and deliveries
/state/
/tasks/
/legacy/
/output/
/delivery/
/inputs/
/input/
/data/
/assets/
转换报告.md
交付清单.json
*.pdf
*.PDF
*.zip
*.ZIP
*.7z
*.rar
*.tar
*.gz
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.webp
*.log
*.sqlite*
*.db

# Environments, caches and generated artifacts
.venv/
venv/
.mineru-home/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv-cache/
.npm-cache/
node_modules/
build/
dist/
*.egg-info/
tmp*/
.coverage
htmlcov/
*.tmp
*.lock
# Dependency lockfiles are public and must remain reproducible.
!package-lock.json

# Editor and operating-system metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
